{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  // `tests/workflow_contracts/data` holds byte-for-byte documentation
  // baselines; linting them would force edits that break the contract.
  "ignores": ["**/.venv/**", ".node_modules/**", "**/node_modules/**", "**/.uv-cache/**", "**/.vtcode/**", "**/target/**", "tests/workflow_contracts/data/**"]
}
