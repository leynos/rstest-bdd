target/
**/*.rs.bk
**/*~
.crush
__pycache__/
.vale/
.grepai/
.memdb/
rust_out
.agents/mcp/context_pack/packs/
crates/rstest-bdd-harness/.proptest-regressions/
proptest-regressions/
